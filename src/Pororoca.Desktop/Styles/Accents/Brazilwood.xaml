<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pororoca.Desktop">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="{x:Static local:PororocaThemeManager.Brazilwood}">
      <!-- System colours overrides below -->
      <Color x:Key="SystemAccentColorDark1">#4C0224</Color>
      <Color x:Key="SystemAccentColor">#6C153D</Color>
      <Color x:Key="SystemAccentColorLight1">#7F3457</Color>
      <Color x:Key="SystemErrorTextColor">#FF4D4D</Color>
      <!-- Custom colours below -->
      <Color x:Key="InputBackgroundValidationProblemColor">#66FECADA</Color>
      <Color x:Key="SystemInvertedAccentColor">#3A6F42</Color>
      <Color x:Key="SystemInvertedAccentColorLight2">#4F7E56</Color>
      <Color x:Key="MainWindowMenuColor">Black</Color>
      <Color x:Key="MainWindowBackgroundColor">#5A022B</Color>
      <Color x:Key="MainWindowDarkerBackgroundColor">#19010C</Color>
      <Color x:Key="MainWindowSidebarColor">#19010C</Color>
      <Color x:Key="MainWindowSeparatorsColor">#19010C</Color>
      <Color x:Key="ListBoxBackgroundColor">Black</Color>
      <Color x:Key="ListBoxItemSelectedBackgroundColor">#562F10</Color>
      <Color x:Key="ResultsListBoxItemSelectedBackgroundColor">#292929</Color>
      <Color x:Key="DragAndDropItemDraggingColor">White</Color>
      
      <Thickness x:Key="ButtonSecondaryBorderThickness">0</Thickness>
      <Color x:Key="ButtonSecondaryBorderBrush">Transparent</Color>
      <Color x:Key="ButtonSecondaryHighlightBorderBrush">Transparent</Color>
      <Color x:Key="ButtonSecondaryBackgroundColor">Black</Color>
      <Color x:Key="ButtonSecondaryHighlightBackgroundColor">#330118</Color>

      <Color x:Key="WebSocketConnectedColor">#E7D101</Color>
      <Color x:Key="WebSocketMessageFromClientPrimaryColor">#E7D101</Color>
      <Color x:Key="WebSocketMessageFromServerPrimaryColor">#6C9472</Color>
      <Color x:Key="DefaultIconsColor">#ECECEC</Color>
      <Color x:Key="DefaultTextForegroundColor">#ECECEC</Color>
      <x:String x:Key="TextEditorTheme">Red</x:String>
      <Color x:Key="TextEditorBackgroundColor">Black</Color>
      <Color x:Key="TextEditorForegroundColor">#D4D4D4</Color>
      <Color x:Key="TextEditorHyperlinkForegroundColor">LightBlue</Color>
      <Color x:Key="ResponseCapturedValueTextColor">#E7D101</Color>
      <Color x:Key="RegularVariableForegroundColor">#E7D101</Color>
      <Color x:Key="RegularVariablePopupForegroundColor">#E7D101</Color>
      <Color x:Key="PredefinedVariableForegroundColor">PeachPuff</Color>
      <Color x:Key="PredefinedVariablePopupForegroundColor">PeachPuff</Color>
      <Color x:Key="NoMatchingVariableForegroundColor">Red</Color>
      <Color x:Key="NoMatchingVariablePopupForegroundColor">Red</Color>
      <Color x:Key="PVSHTextBlockDefaultForegroundColor">White</Color>

      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E7D101"/>

      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#6C153D"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#7F3457"/>
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#9D637E"/>

      <!--SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#055163"/-->
      <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#6C153D"/>
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#6C153D"/>

      <!--SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#055163"/-->
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#6C153D"/>
      
      <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush" Color="#E5CA00"/>
      <SolidColorBrush x:Key="ButtonPrimaryTextBrush" Color="Black"/>
      <SolidColorBrush x:Key="ButtonPrimaryHighlightBackgroundBrush" Color="#EEDE46"/>
      <SolidColorBrush x:Key="ButtonPrimaryHighlightTextBrush" Color="Black"/>
      <SolidColorBrush x:Key="ButtonPrimaryInvertedTextBrush" Color="#ECECEC"/>
      <SolidColorBrush x:Key="ButtonPrimaryInvertedHighlightTextBrush" Color="White"/>

      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#19010C"/>
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#19010C"/>
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#19010C"/>
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#19010C"/>

      <!-- don't rename key below -->
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#6C153D"/>
      <!-- value below sets hover variable popup max width -->
      <x:Double x:Key="FlyoutThemeMaxWidth">720</x:Double>
      <!--Color x:Key="TreeViewItemTargetMovementHighlightColor">LawnGreen</Color-->
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>